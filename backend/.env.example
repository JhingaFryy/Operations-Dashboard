# Copy to .env and fill in real values. .env is git-ignored — never commit real secrets.

# RDCMS is the existing PostgreSQL database owned by BL-DCMS. This app only
# reads/writes the tables it needs (users, sections, dashboard_access) —
# it must never run DDL or migrations against it.
RDCMS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/rdcms

# Base URL of the Loco Master HTTP API. Loco Master owns the "loco" database
# directly; this app must never connect to it — only talk to it over HTTP.
LOCO_MASTER_BASE_URL=http://localhost:8100

# Use a secret distinct from BL-DCMS's JWT_SECRET_KEY: this app's tokens are
# a separate trust domain and should not be interchangeable with BL-DCMS's.
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional: HTTP timeout (seconds) for calls to Loco Master.
LOCO_MASTER_TIMEOUT_SECONDS=10

# Optional. Must match Loco Master's own LOCO_MASTER_INTERNAL_API_KEY
# (see /opt/loco-master/.env.example) if it has one configured — sent as
# the X-Internal-API-Key header on every call. Leave blank if Loco Master
# doesn't require it yet.
LOCO_MASTER_INTERNAL_API_KEY=

# BL-DCMS Integration Phase 4 (read-only checksheet status/progress). BL-DCMS owns checksheet
# templates/submissions/DSC signing directly — this app must never connect to its database or
# mutate its records, only read via its /integration/* HTTP API. Both left blank/optional: the
# integration is not load-bearing for core Dashboard function, so leaving these unset makes
# GET /api/shed-visits/{id}/checksheets and .../checksheet-summary report a controlled
# "unavailable" state rather than crashing the whole app at startup.
#
# Recommended production value: http://127.0.0.1:8080 (BL-DCMS's own backend, bound to
# localhost only — this app must reach it over loopback, never a public address).
BLDCMS_BASE_URL=

# Must match BL-DCMS's own BLDCMS_INTERNAL_API_KEY exactly (see that project's systemd unit /
# override.conf) — sent as the X-Internal-API-Key header on every call. BL-DCMS fails closed
# (401) if it has no key of its own configured, so a mismatch here surfaces as "unavailable",
# not a silent zero-checksheets result.
BLDCMS_INTERNAL_API_KEY=

# Optional: HTTP timeout (seconds) for calls to BL-DCMS.
BLDCMS_TIMEOUT_SECONDS=10

# Operations Dashboard Phase 5B.4A: the INBOUND counterpart of BLDCMS_INTERNAL_API_KEY above.
# This is the key BL-DCMS must send back to THIS app (as X-Internal-API-Key) when it calls
# POST /api/internal/shed-visits/{id}/reconcile-checksheet-stages after a checksheet becomes
# APPROVED - not a key this app sends elsewhere. Generate a long random value distinct from
# BLDCMS_INTERNAL_API_KEY and give BL-DCMS the matching value to configure on its side. Left
# blank/optional: until this is set, the internal route fails closed (401) for every request,
# including a correct-looking one - there is no way to tell from the outside whether it's simply
# unset or whether a given key is wrong. Never commit a real value; never expose this to frontend
# code.
OPERATIONS_INTERNAL_API_KEY=
